#: CommandOutputContext.cpp:127 CommandOutputContext.cpp:149
#, kde-kuit-format
msgctxt "@info"
msgid "Could not load page content"
msgstr "Ne mogu da učitam sadržaj stranice"

#: CommandOutputContext.cpp:129
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Technical details: The <command>%1</command> tool is required to display "
"this page, but could not be found. You may be able to install it using your "
"package manager; either way, please report this packaging issue to %2."
msgstr ""
"Tehnički detalji: alatka <command>%1</command> potrebna je za prikaz ove "
"stranice, ali nije nađena. Možda možete da je instalirate menadžerom paketa; "
"u svakom slučaju, prijavite ovaj problem pakovanja distribuciji %2."

#: CommandOutputContext.cpp:150
#, kde-kuit-format
msgctxt "@Info"
msgid ""
"Technical details: the <command>%1</command> tool crashed while generating "
"page content."
msgstr ""
"Tehnički detalji: alatka <command>%1</command> se srušila pri stvaranju "
"sadržaja stranice."


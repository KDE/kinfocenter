#: MemoryEntry.cpp:24
#, kde-format
msgid "Memory:"
msgstr "Memorija:"

#: MemoryEntry.cpp:129
#, kde-format
msgctxt ""
"@label, %1 is the total amount of installed system memory, %2 is the amount "
"of which is usable, both expressed as 7.7 GiB"
msgid "%1 of RAM (%2 usable)"
msgstr "%1 RAM‑a (%2 upotrebljivo)"

#: MemoryEntry.cpp:137
#, kde-format
msgctxt ""
"@label, %1 is the amount of installed system memory expressed as 7.7 GiB"
msgid "%1 of RAM"
msgstr "%1 RAM‑a"

#: MemoryEntry.cpp:144
#, kde-format
msgctxt "@label, %1 is the amount of usable system memory expressed as 7.7 GiB"
msgid "%1 of usable RAM"
msgstr "%1 upotrebljivog RAM‑a"

# >! Contexts.
#: MemoryEntry.cpp:150
#, kde-format
msgctxt "@label, Unknown amount of system memory"
msgid "Unknown"
msgstr "nepoznato"

#: MemoryEntry.cpp:158
#, kde-format
msgctxt "@info:tooltip, referring to system memory or RAM"
msgid ""
"Some memory is reserved for use by the kernel or system hardware such as "
"integrated graphics memory."
msgstr ""
"Dio memorije je rezervisan za jezgro ili sistemski hardver, kao što je "
"memorija integrisane grafike."

#: MemoryEntry.cpp:166
#, kde-format
msgctxt "@info:tooltip, referring to system memory or RAM"
msgid ""
"The amount of usable memory may be lower than the displayed amount because "
"some memory is reserved for use by the kernel or system hardware, such as "
"integrated graphics memory."
msgstr ""
"Količina upotrebljive memorije može biti manja od prikazane zato što je dio "
"memorije rezervisan za jezgro ili sistemski hardver, kao što je memorija "
"integrisane grafike."

#: MemoryEntry.cpp:175
#, kde-format
msgctxt "@info:tooltip, referring to system memory or RAM"
msgid ""
"The amount of memory displayed may be lower than the installed amount "
"because some memory is reserved for use by the kernel or system hardware, "
"such as integrated graphics memory."
msgstr ""
"Prikazana količina memorije može biti manja od ugrađene zato što je dio "
"memorije rezervisan za jezgro ili sistemski hardver, kao što je memorija "
"integrisane grafike."


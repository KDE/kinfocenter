#: CommandOutputContext.cpp:127 CommandOutputContext.cpp:149
#, kde-kuit-format
msgctxt "@info"
msgid "Could not load page content"
msgstr "Αδυναμία φόρτωσης περιεχομένου σελίδας"

#: CommandOutputContext.cpp:129
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Technical details: The <command>%1</command> tool is required to display "
"this page, but could not be found. You may be able to install it using your "
"package manager; either way, please report this packaging issue to %2."
msgstr ""
"Τεχνικές λεπτομέρειες: Το εργαλείο <command>%1</command> απαιτείται για την "
"εμφάνισητης σελίδας αλλά, δεν βρέθηκε. Ίσως μπορέσετε να εγκαταστήσετε "
"χρησιμοποιώντας τονδιαχειριστή πακέτων σας. Όπως και να 'χει, παρακαλούμε να "
"αναφέρετε αυτό το ζήτημα πακέτων στο %2."

#: CommandOutputContext.cpp:150
#, kde-kuit-format
msgctxt "@Info"
msgid ""
"Technical details: the <command>%1</command> tool crashed while generating "
"page content."
msgstr ""
"Τεχνικές λεπτομέρειες: Το εργαλείο <command>%1</command> διακόπηκε απότομα "
"κατά την δημιουργία του περιεχομένου της σελίδας."

#: qml/CommandOutputKCM.qml:108
#, kde-format
msgctxt "@info"
msgid "No text matching the filter"
msgstr "Κανένα κείμενο δεν ταιριάζει με το φίλτρο"

#: qml/CommandOutputKCM.qml:113
#, kde-format
msgctxt "@info the KCM has no data to display"
msgid "No data available"
msgstr "Δεν υπάρχουν διαθέσιμα δεδομένα"

#: qml/CommandOutputKCM.qml:126
#, kde-format
msgid "Report to %1"
msgstr "Αναφορά στο %1"

#: qml/CommandOutputKCM.qml:192
#, kde-format
msgctxt "@label placeholder text to filter for something"
msgid "Filter…"
msgstr "Φίλτρο…"

#: qml/CommandOutputKCM.qml:194
#, kde-format
msgctxt "accessible name for filter input"
msgid "Filter"
msgstr "Φίλτρο"

#: qml/CommandOutputKCM.qml:206
#, kde-format
msgctxt "@action:button close filter header"
msgid "Close"
msgstr "Κλείσιμο"

#: qml/CommandOutputKCM.qml:231
#, kde-format
msgctxt "@action:button pauses automatic refreshing"
msgid "Pause Refreshing"
msgstr "Παύση ανανέωσης"

#: qml/CommandOutputKCM.qml:239
#, kde-format
msgctxt "@action:button resumes automatic refreshing"
msgid "Resume Refreshing"
msgstr "Συνέχιση ανανέωσης"

#: qml/CommandOutputKCM.qml:246
#, kde-format
msgctxt "@action:button copies all displayed text"
msgid "Copy to Clipboard"
msgstr "Αντιγραφή στο πρόχειρο"

#: qml/CommandOutputKCM.qml:254
#, kde-format
msgctxt "@action:button opens filter bar"
msgid "Filter"
msgstr "Φίλτρο"

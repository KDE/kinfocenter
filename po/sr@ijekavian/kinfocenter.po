#: CommandOutputContext.cpp:127 CommandOutputContext.cpp:149
#, kde-kuit-format
msgctxt "@info"
msgid "Could not load page content"
msgstr "Не могу да учитам садржај странице"

#: CommandOutputContext.cpp:129
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Technical details: The <command>%1</command> tool is required to display "
"this page, but could not be found. You may be able to install it using your "
"package manager; either way, please report this packaging issue to %2."
msgstr ""
"Технички детаљи: алатка <command>%1</command> потребна је за приказ ове "
"странице, али није нађена. Можда можете да је инсталирате менаџером пакета; "
"у сваком случају, пријавите овај проблем паковања дистрибуцији %2."

#: CommandOutputContext.cpp:150
#, kde-kuit-format
msgctxt "@Info"
msgid ""
"Technical details: the <command>%1</command> tool crashed while generating "
"page content."
msgstr ""
"Технички детаљи: алатка <command>%1</command> се срушила при стварању "
"садржаја странице."

